#include <iostream>
#include <vector>
#include <algorithm>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        int n;
        cin >> n;

        vector<int> fact(1, 1);

        for (int i = 2; i <= n; i++) {
            int carry = 0;

            for (int j = 0; j < fact.size(); j++) {
                int value = fact[j] * i + carry;
                fact[j] = value % 10;
                carry = value / 10;
            }

            while (carry) {
                fact.push_back(carry % 10);
                carry /= 10;
            }
        }

        reverse(fact.begin(), fact.end());

        for (int digit : fact)
            cout << digit;

        cout << '\n';
    }

    return 0;
}